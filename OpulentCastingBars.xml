<Ui xmlns="http://www.blizzard.com/wow/ui/"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://www.blizzard.com/wow/ui/">

  <Frame name="OCBMinimapButtonFrame" parent="Minimap" hidden="true" frameStrata="MEDIUM">
    <Size><AbsDimension x="33" y="33"/></Size>
    <Anchors>
      <Anchor point="CENTER" relativeTo="Minimap" relativePoint="CENTER">
        <Offset><AbsDimension x="-57" y="-57"/></Offset>
      </Anchor>
    </Anchors>
    <Frames>
      <Button name="OCBMinimapButton" enableMouse="true" movable="false">
        <HighlightTexture alphaMode="ADD" file="Interface\Buttons\ButtonHilight-Round"/>
        <Size><AbsDimension x="33" y="33"/></Size>
        <Anchors><Anchor point="TOPLEFT"/></Anchors>
        <Layers>
          <Layer level="BACKGROUND">
            <Texture name="$parentIcon" file="Interface\Icons\Spell_fire_flamebolt">
              <Size><AbsDimension x="19" y="19"/></Size>
              <Anchors>
                <Anchor point="CENTER">
                  <Offset><AbsDimension x="-1" y="2"/></Offset>
                </Anchor>
              </Anchors>
              <TexCoords left="0.075" right="0.925" top="0.075" bottom="0.925"/>
            </Texture>
          </Layer>
          <Layer level="OVERLAY">
            <Texture name="$parentBorder" file="Interface\Minimap\MiniMap-TrackingBorder">
              <Size><AbsDimension x="52" y="52"/></Size>
              <Anchors><Anchor point="TOPLEFT"/></Anchors>
            </Texture>
          </Layer>
        </Layers>
        <Scripts>
          <OnMouseDown>OCBMinimapButton_OnMouseDown(button);</OnMouseDown>
          <OnMouseUp>OCBMinimapButton_OnMouseUp(button);</OnMouseUp>
          <OnEnter>OCBMinimapButton_OnEnter();</OnEnter>
          <OnLeave>OCBMinimapButton_OnLeave();</OnLeave>
        </Scripts>
      </Button>
    </Frames>
  </Frame>

</Ui>
